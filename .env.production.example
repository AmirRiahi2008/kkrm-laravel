APP_NAME="KKRM Portal"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://kkrm.irancompile.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

FRONTEND_URL=https://kkrm.irancompile.com
CORS_ALLOWED_ORIGINS=https://kkrm.irancompile.com
SANCTUM_STATEFUL_DOMAINS=kkrm.irancompile.com
TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kkr
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
MEDIA_DISK=local
MEDIA_LOCAL_ROOT=
MEDIA_PUBLIC_ROOT=
MEDIA_LEGACY_ORIGINS=https://kkrm.vercel.app,https://laravel-q2yx48.chbkn.dev
MEDIA_MAX_KB=51200

CLAMAV_ENABLED=false
CLAMAV_BINARY=clamscan

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

BCRYPT_ROUNDS=12

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@kkrm.ir
MAIL_FROM_NAME="KKRM"

CONTACT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
APP_DOWNLOAD_URL=
